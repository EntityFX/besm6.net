*name whets
*ftn
      PROGRAM WHETS
C     Roy Longbottom, whets.for, 11 December 1996.
C     http://www.roylongbottom.org.uk/whets.for
C     BESM-6 Fortran-GDR adaptation: REAL is a 48-bit guest word.
C     COMMON is replaced by explicit arguments; CTIME replaces SECOND.
C     Fixed reproducible workload: IX100=100, IXTRA=8. No calibration
C     or interactive host/file metadata. All eight original kernels,
C     array indexing, T alternation and section operation counts remain.
C     N1 runs ten times longer and its time is divided by ten, as in
C     the original. MWIPS=IXTRA*IX100/(10*normalized section seconds).
C     MFLOPS is the geometric mean of N1, N2 and N6, not MWIPS.
C     Run with --guest-clock --speed original (model) or virtual (host).
      REAL E(4), T, T0, T1, T2, X, Y, Z
      REAL CT0, RT0, CT1, RT1, SECS, WIPS, GM
      REAL TS(8), VAL(8), RATE(8), WORK(8), REFVAL(8)
      INTEGER I, IX, J, K, L, NERR, NBAD
      DATA WORK / 153600., 1075200., 828000., 2520000.,
     + 665600., 4315200., 1478400., 297600. /
C     Independent binary64 evaluation of the original kernels, eight
C     passes. 1E-6 allows accumulated 40-bit guest mantissa roundoff.
      DATA REFVAL / -1.13333333059052, -1.13333328610525,
     + 1., 12., 0.50000005785012, 0.99999980904064,
     + 3., 0.75792040197525 /
      T=0.49999975
      T0=T
      T1=0.50000025
      T2=2.
C     N1: N1=1200, N1MULT=10; carry E across the eight passes.
      E(1)=1.
      E(2)=-1.
      E(3)=-1.
      E(4)=-1.
      CALL CTIME(CT0,RT0)
      DO 11 IX=1,8
      DO 10 I=1,12000
      E(1)=(E(1)+E(2)+E(3)-E(4))*T
      E(2)=(E(1)+E(2)-E(3)+E(4))*T
      E(3)=(E(1)-E(2)+E(3)+E(4))*T
      E(4)=(-E(1)+E(2)+E(3)+E(4))*T
   10 CONTINUE
   11 T=1.-T
      CALL CTIME(CT1,RT1)
      TS(1)=(RT1-RT0)/10.
      VAL(1)=E(4)
      T=T0
C     N2: array passed to PA; six repetitions in each call.
      CALL CTIME(CT0,RT0)
      DO 21 IX=1,8
      DO 20 I=1,1400
   20 CALL PA(E,T,T2)
   21 T=1.-T
      CALL CTIME(CT1,RT1)
      TS(2)=RT1-RT0
      VAL(2)=E(4)
      T=T0
C     N3: conditional jumps.
      J=1
      CALL CTIME(CT0,RT0)
      DO 31 IX=1,8
      DO 30 I=1,34500
      IF (J .EQ. 1) GO TO 301
      J=3
      GO TO 302
  301 J=2
  302 IF (J .GT. 2) GO TO 303
      J=1
      GO TO 304
  303 J=0
  304 IF (J .LT. 1) GO TO 305
      J=0
      GO TO 30
  305 J=1
   30 CONTINUE
   31 CONTINUE
      CALL CTIME(CT1,RT1)
      TS(3)=RT1-RT0
      VAL(3)=FLOAT(J)
C     N4: preserve the original dynamic array subscripts.
      J=1
      K=2
      L=3
      CALL CTIME(CT0,RT0)
      DO 41 IX=1,8
      DO 40 I=1,21000
      J=J*(K-J)*(L-K)
      K=L*K-(L-J)*K
      L=(L-K)*(K+J)
      E(L-1)=FLOAT(J+K+L)
      E(K-1)=FLOAT(J*K*L)
   40 CONTINUE
   41 CONTINUE
      CALL CTIME(CT1,RT1)
      TS(4)=RT1-RT0
      VAL(4)=E(1)+E(2)
C     N5: 32*100 iterations, alternate T after every pass.
      X=0.5
      Y=0.5
      CALL CTIME(CT0,RT0)
      DO 51 IX=1,8
      DO 50 I=1,3200
      X=T*ATAN(T2*SIN(X)*COS(X)
     + /(COS(X+Y)+COS(X-Y)-1.))
      Y=T*ATAN(T2*SIN(Y)*COS(Y)
     + /(COS(X+Y)+COS(X-Y)-1.))
   50 CONTINUE
   51 T=1.-T
      CALL CTIME(CT1,RT1)
      TS(5)=RT1-RT0
      VAL(5)=Y
      T=T0
C     N6: original floating point procedure, six operations/call.
      X=1.
      Y=1.
      Z=1.
      CALL CTIME(CT0,RT0)
      DO 61 IX=1,8
      DO 60 I=1,89900
   60 CALL P3(X,Y,Z,T,T1,T2)
   61 CONTINUE
      CALL CTIME(CT1,RT1)
      TS(6)=RT1-RT0
      VAL(6)=Z
C     N7: indexed array references, not scalar substitutes.
      J=1
      K=2
      L=3
      E(1)=1.
      E(2)=2.
      E(3)=3.
      CALL CTIME(CT0,RT0)
      DO 71 IX=1,8
      DO 70 I=1,61600
   70 CALL PO(E,J,K,L)
   71 CONTINUE
      CALL CTIME(CT1,RT1)
      TS(7)=RT1-RT0
      VAL(7)=E(3)
C     N8: exp, log, sqrt; keep X across passes.
      X=0.75
      CALL CTIME(CT0,RT0)
      DO 81 IX=1,8
      DO 80 I=1,9300
   80 X=SQRT(EXP(ALOG(X)/T1))
   81 CONTINUE
      CALL CTIME(CT1,RT1)
      TS(8)=RT1-RT0
      VAL(8)=X
C     Every raw interval must be at least two 20 ms timer quanta.
      NERR=0
      NBAD=0
      SECS=0.
      DO 90 I=1,8
      IF (ABS(VAL(I)-REFVAL(I)) .GT. 0.000001) NBAD=NBAD+1
      RATE(I)=0.
      IF (TS(I) .LT. 0.04 .AND. I .NE. 1) NERR=NERR+1
      IF (I .EQ. 1 .AND. TS(I) .LT. 0.004) NERR=NERR+1
      IF (TS(I) .GT. 0.) RATE(I)=WORK(I)/(1000000.*TS(I))
   90 SECS=SECS+TS(I)
      PRINT 100
      PRINT 101
      PRINT 102
      PRINT 111, VAL(1), RATE(1), TS(1)
      PRINT 112, VAL(2), RATE(2), TS(2)
      PRINT 113, VAL(3), RATE(3), TS(3)
      PRINT 114, VAL(4), RATE(4), TS(4)
      PRINT 115, VAL(5), RATE(5), TS(5)
      PRINT 116, VAL(6), RATE(6), TS(6)
      PRINT 117, VAL(7), RATE(7), TS(7)
      PRINT 118, VAL(8), RATE(8), TS(8)
      PRINT 124, NBAD
      IF (NBAD .NE. 0) GO TO 96
      PRINT 125
      IF (NERR .NE. 0) GO TO 95
      WIPS=800./(10.*SECS)
      GM=EXP((ALOG(RATE(1))+ALOG(RATE(2))+ALOG(RATE(6)))/3.)
      PRINT 120, SECS
      PRINT 121, WIPS
      PRINT 122, GM
      STOP
   95 PRINT 123
      STOP
   96 PRINT 126
      STOP
  100 FORMAT ('ROY LONGBOTTOM WHETSTONE - BESM-6 FORTRAN-GDR')
  101 FORMAT ('8 PASSES USED (X 100); REAL IS 48 BITS')
  102 FORMAT ('LOOP CONTENT              RESULT',
     + '                 MFLOPS       MOPS    SECONDS')
  111 FORMAT ('N1 FLOATING POINT ', F24.14, F12.6, 12X, F12.4)
  112 FORMAT ('N2 FLOATING POINT ', F24.14, F12.6, 12X, F12.4)
  113 FORMAT ('N3 IF THEN ELSE   ', F24.14, 12X, F12.6, F12.4)
  114 FORMAT ('N4 FIXED POINT    ', F24.14, 12X, F12.6, F12.4)
  115 FORMAT ('N5 SIN,COS ETC.   ', F24.14, 12X, F12.6, F12.4)
  116 FORMAT ('N6 FLOATING POINT ', F24.14, F12.6, 12X, F12.4)
  117 FORMAT ('N7 ASSIGNMENTS    ', F24.14, 12X, F12.6, F12.4)
  118 FORMAT ('N8 EXP,SQRT ETC.  ', F24.14, 12X, F12.6, F12.4)
  120 FORMAT ('GUEST CPU SECONDS: ', F12.4)
  121 FORMAT ('GUEST MWIPS: ', F12.6)
  122 FORMAT ('GUEST MFLOPS GEOMEAN N1 N2 N6: ', F12.6)
  123 FORMAT ('RATINGS UNAVAILABLE: ENABLE --GUEST-CLOCK',
     + ' OR RUN LONGER')
  124 FORMAT ('BAD CONTROL VALUES=', I6)
  125 FORMAT ('ALL 8 CONTROL VALUES MATCH: YES')
  126 FORMAT ('RATINGS UNAVAILABLE: CONTROL VALUES DO NOT MATCH')
      END
      SUBROUTINE PA(E,T,T2)
      REAL E(4), T, T2
      INTEGER J
      DO 10 J=1,6
      E(1)=(E(1)+E(2)+E(3)-E(4))*T
      E(2)=(E(1)+E(2)-E(3)+E(4))*T
      E(3)=(E(1)-E(2)+E(3)+E(4))*T
      E(4)=(-E(1)+E(2)+E(3)+E(4))/T2
   10 CONTINUE
      RETURN
      END
      SUBROUTINE P3(X,Y,Z,T,T1,T2)
      REAL X, Y, Z, T, T1, T2
      X=Y
      Y=Z
      X=T*(X+Y)
      Y=T1*(X+Y)
      Z=(X+Y)/T2
      RETURN
      END
      SUBROUTINE PO(E,J,K,L)
      REAL E(4)
      INTEGER J, K, L
      E(J)=E(K)
      E(K)=E(L)
      E(L)=E(J)
      RETURN
      END
*execute
*end file
