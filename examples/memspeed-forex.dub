*name memspeed-forex
*forex
c     MemSpeed-style kernels for BESM-6, native FOREX 4.13 REAL (48 bits).
c     Independent adaptation: copy, add, and scalar multiply/add.
c     Logical traffic counts 6 bytes per guest word, not host RAM bytes.
c     Two arrays occupy 8192 words; active data size is 49152 bytes.
c     KPART=0 skips the kernel for baseline subtraction.
c     CTIME brackets the unchanged kernels; checks/output are untimed.
c     --guest-clock: model seconds in original/max, host in virtual.
      program memspd
      real x(4096), y(4096), scalar, expect, total, bytes
      real ct0, ct1, rt0, rt1, secs, score, first, last
      integer kpart, nwrds, rpts, i, ipas, nbad, byelem
      data kpart/1/
      data nwrds/4096/, rpts/1000/, scalar/0.5/
      do 10 i=1,nwrds
      x(i)=1.0
   10 y(i)=float(i)/4096.0
      call ctime(ct0,rt0)
      if (kpart .eq. 1) then
         do 30 ipas=1,rpts
         do 20 i=1,nwrds
   20    x(i)=y(i)
   30    continue
      else if (kpart .eq. 2) then
         do 50 ipas=1,rpts
         do 40 i=1,nwrds
   40    x(i)=x(i)+y(i)
   50    continue
      else if (kpart .eq. 3) then
         do 70 ipas=1,rpts
         do 60 i=1,nwrds
   60    x(i)=x(i)+scalar*y(i)
   70    continue
      endif
      call ctime(ct1,rt1)
      secs=rt1-rt0
      nbad=0
      total=0.0
      do 80 i=1,nwrds
      expect=1.0
      if (kpart .eq. 1) expect=y(i)
      if (kpart .eq. 2) expect=1.0+float(rpts)*y(i)
      if (kpart .eq. 3) expect=1.0+float(rpts)*scalar*y(i)
      if (abs(x(i)-expect) .gt. 0.00000001) nbad=nbad+1
   80 total=total+x(i)
      if (nwrds .ne. 4096 .or. rpts .ne. 1000) nbad=nbad+1
      if (kpart .lt. 0 .or. kpart .gt. 3) nbad=nbad+1
      byelem=0
      if (kpart .eq. 1) byelem=12
      if (kpart .eq. 2 .or. kpart .eq. 3) byelem=18
      bytes=float(nwrds)*float(rpts)*float(byelem)
      print 100, kpart
      print 200, nwrds
      print 210, rpts
      print 220, byelem
      print 300, bytes
      first=x(1)
      last=x(nwrds)
      print 400, first
      print 410, last
      print 420, total
      print 430, nbad
      if (nbad .eq. 0) print 900
      if (nbad .ne. 0) print 950
      if (nbad .ne. 0) then
         print 1030
      else if (kpart .eq. 0) then
         print 1020
      else if (secs .lt. 0.04) then
         print 1040
      else
         score=bytes/(secs*1000000.)
         print 1000, secs
         print 1010, score
      endif
      stop
 100  format ('MEMSPEED PART ', i2)
 200  format ('WORDS=', i6)
 210  format ('REPEAT PASSES=', i6)
 220  format ('BYTES/ELEMENT=', i3)
 300  format ('DATA TRAFFIC BYTES=', f24.12)
 400  format ('FIRST RESULT=', f24.12)
 410  format ('LAST RESULT=', f24.12)
 420  format ('CHECKSUM=', f24.12)
 430  format ('BAD ELEMENTS=', i6)
 900  format ('ALL VALUES MATCH: YES')
 950  format ('ALL VALUES MATCH: NO')
 1000 format ('GUEST CPU SECONDS: ', f12.4)
 1010 format ('GUEST MB/S: ', f12.6)
 1020 format ('MB/S UNAVAILABLE: ZERO KERNEL')
 1030 format ('MB/S UNAVAILABLE: CONTROL VALUES DO NOT MATCH')
 1040 format ('MB/S UNAVAILABLE: ENABLE --GUEST-CLOCK',
     + ' OR RUN LONGER')
      end
*execute
*end file
