*name branches
*madlen
 PROGRAM: ,NAME,
C BEGIN CODE
          ,NTR,0
          ,XTA,X
          ,A-X,Y
          ,U1A,LESS
          ,XTA,X
          ,UJ,SAVE
 LESS:    ,XTA,Y
 SAVE:    ,ATX,RESULT
C END CODE
          ,XTA,RESULT
          ,AEX,EXPECT
          ,U1A,FAIL
          ,*64,OKINFO
          ,*74,
 FAIL:    ,*64,BADINFO
          ,*74,
C BEGIN DATA
 X:       ,REAL,7.
 Y:       ,REAL,3.
 RESULT:  ,REAL,0.
C END DATA
 EXPECT:  ,REAL,7.
 OKINFO:  ,    ,OKTEXT
          ,    ,OKTEXT
          ,001,
         8,    ,
 BADINFO: ,    ,BADTEXT
          ,    ,BADTEXT
          ,001,
         8,    ,
 OKTEXT:  ,GOST,6HOK 03
          ,GOST,6H'231'
 BADTEXT: ,GOST,6HFAIL03
          ,GOST,6H'231'
          ,END,
*execute
*end file
