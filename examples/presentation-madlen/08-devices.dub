*name devices
*madlen
 PROGRAM: ,NAME,
C BEGIN CODE
          ,NTR,0
          ,XTA,X
          ,A+X,Y
          ,ATX,RESULT
          ,*64,HEADINFO
          ,*64,VALINFO
C END CODE
          ,XTA,RESULT
          ,AEX,EXPECT
          ,U1A,FAIL
          ,*64,OKINFO
          ,*74,
 FAIL:    ,*64,BADINFO
          ,*74,
C BEGIN DATA
 X:       ,REAL,20.
 Y:       ,REAL,40.
 RESULT:  ,REAL,0.
C END DATA
C BEGIN OUTPUT
 HEADINFO:,    ,TEXT
          ,    ,TEXT
          ,001,
         8,    ,
 TEXT:    ,GOST,6HRESULT
          ,GOST,6H'231'
 VALINFO: ,    ,RESULT
          ,    ,RESULT
         3,    ,10
         8,024,
C END OUTPUT
 EXPECT:  ,REAL,60.
 OKINFO:  ,    ,OKTEXT
          ,    ,OKTEXT
          ,001,
         8,    ,
 BADINFO: ,    ,BADTEXT
          ,    ,BADTEXT
          ,001,
         8,    ,
 OKTEXT:  ,GOST,6HOK 08
          ,GOST,6H'231'
 BADTEXT: ,GOST,6HFAIL08
          ,GOST,6H'231'
          ,END,
*execute
*end file
