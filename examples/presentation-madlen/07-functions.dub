*name functions
*madlen
 PROGRAM: ,NAME,
C BEGIN CODE
          ,NTR,0
          ,XTA,ARG
        13,VJM,TWICE
          ,ATX,RESULT
C END CODE
          ,XTA,RESULT
          ,AEX,EXPECT
          ,U1A,FAIL
          ,*64,OKINFO
          ,*74,
 FAIL:    ,*64,BADINFO
          ,*74,
C BEGIN FUNCTION
 TWICE:   ,A*X,FACTOR
        13,UJ,
C END FUNCTION
C BEGIN DATA
 ARG:     ,REAL,3.
 FACTOR:  ,REAL,2.
 RESULT:  ,REAL,0.
C END DATA
 EXPECT:  ,REAL,6.
 OKINFO:  ,    ,OKTEXT
          ,    ,OKTEXT
          ,001,
         8,    ,
 BADINFO: ,    ,BADTEXT
          ,    ,BADTEXT
          ,001,
         8,    ,
 OKTEXT:  ,GOST,6HOK 07
          ,GOST,6H'231'
 BADTEXT: ,GOST,6HFAIL07
          ,GOST,6H'231'
          ,END,
*execute
*end file
