*name chess mate
*fortran
c---- Mini chess: white king and rook find mate in one
      program chess
      integer b(8,8),dr(4),dc(4)
      integer i,j,k,d,nr,nc,rr,rc,res,res2,legal,sav
      integer nmove,mate,mr,mc
      do 10 i=1,8
        do 10 j=1,8
          b(i,j)=0
   10 continue
      b(6,7)=1
      b(1,1)=2
      b(8,8)=-1
      dr(1)=-1
      dc(1)=0
      dr(2)=1
      dc(2)=0
      dr(3)=0
      dc(3)=-1
      dr(4)=0
      dc(4)=1
      rr=1
      rc=1
      nmove=0
      mate=0
      mr=0
      mc=0
      do 100 d=1,4
        nr=rr+dr(d)
        nc=rc+dc(d)
   40   continue
        if (nr .lt. 1) goto 100
        if (nr .gt. 8) goto 100
        if (nc .lt. 1) goto 100
        if (nc .gt. 8) goto 100
        if (b(nr,nc) .eq. 1) goto 100
        if (b(nr,nc) .eq. -1) goto 100
        b(rr,rc)=0
        b(nr,nc)=2
        nmove=nmove+1
        call chk(b,8,8,res)
        if (res .eq. 0) goto 80
        legal=0
        do 50 k=1,4
          i=8+dr(k)
          j=8+dc(k)
          if (i .lt. 1) goto 50
          if (i .gt. 8) goto 50
          if (j .lt. 1) goto 50
          if (j .gt. 8) goto 50
          if (b(i,j) .eq. 1) goto 50
          sav=b(i,j)
          b(8,8)=0
          b(i,j)=-1
          call chk(b,i,j,res2)
          if (res2 .eq. 0) legal=1
          b(i,j)=sav
          b(8,8)=-1
          if (legal .eq. 1) goto 60
   50   continue
   60   continue
        if (legal .eq. 0) goto 70
        goto 80
   70   continue
        mate=mate+1
        mr=nr
        mc=nc
   80   continue
        b(nr,nc)=0
        b(rr,rc)=2
        nr=nr+dr(d)
        nc=nc+dc(d)
        goto 40
  100 continue
      print 200, nmove, mate
      if (mate .gt. 0) print 210, mr, mc
      stop
 200  format('ROOK MOVES=',i3,' MATES=',i3)
 210  format('MATE IN 1: ROOK 1 1 -> ',i2,1x,i2)
      end
      subroutine chk(b,kr,kc,res)
      integer b(8,8),dr(4),dc(4)
      integer kr,kc,res,i,j,d,i1,i2,j1,j2
      dr(1)=-1
      dc(1)=0
      dr(2)=1
      dc(2)=0
      dr(3)=0
      dc(3)=-1
      dr(4)=0
      dc(4)=1
      res=0
      i1=kr-1
      i2=kr+1
      j1=kc-1
      j2=kc+1
      do 20 i=i1,i2
        do 20 j=j1,j2
          if (i .lt. 1) goto 20
          if (i .gt. 8) goto 20
          if (j .lt. 1) goto 20
          if (j .gt. 8) goto 20
          if (b(i,j) .eq. 1) res=1
   20 continue
      do 30 d=1,4
        i=kr
        j=kc
   31   i=i+dr(d)
        j=j+dc(d)
        if (i .lt. 1) goto 30
        if (i .gt. 8) goto 30
        if (j .lt. 1) goto 30
        if (j .gt. 8) goto 30
        if (b(i,j) .eq. 0) goto 31
        if (b(i,j) .eq. 2) res=1
        goto 30
   30 continue
      return
      end
*execute
*end file
