*name scale chess
*fortran
      program chess
      integer b(8,8),iw,ir,wr,wc,rr,rc,i,j,res,np
      integer nm,mt,mr,mc,tm,tt,cs
      np=0
      tm=0
      tt=0
      cs=0
      do 100 iw=1,64
        wr=(64-iw)/8+1
        wc=(64-iw)-8*((64-iw)/8)+1
        if (wr .ge. 7 .and. wc .ge. 7) goto 100
        do 90 ir=1,64
          rr=(ir-1)/8+1
          rc=ir-8*((ir-1)/8)
          if (rr .eq. wr .and. rc .eq. wc) goto 90
          if (rr .eq. 8 .and. rc .eq. 8) goto 90
          do 20 i=1,8
            do 10 j=1,8
              b(i,j)=0
   10       continue
   20     continue
          b(wr,wc)=1
          b(rr,rc)=2
          b(8,8)=-1
          call chk(b,8,8,res)
          if (res .ne. 0) goto 90
          call solve(b,rr,rc,nm,mt,mr,mc)
          np=np+1
          tm=tm+nm
          tt=tt+mt
          cs=cs+np*(nm+64*mt)
          cs=cs-65521*(cs/65521)
          if (np .eq. 256) goto 200
   90   continue
  100 continue
  200 print 300, np,tm,tt,cs
      stop
  300 format('RESULT',4i12)
      end
      subroutine solve(b,rr,rc,nmove,mate,mr,mc)
      integer b(8,8),dr(4),dc(4)
      integer rr,rc,nmove,mate,mr,mc
      integer i,j,k,d,nr,nc,res,res2,legal,sav
      dr(1)=-1
      dc(1)=0
      dr(2)=1
      dc(2)=0
      dr(3)=0
      dc(3)=-1
      dr(4)=0
      dc(4)=1
      nmove=0
      mate=0
      mr=0
      mc=0
      do 100 d=1,4
        nr=rr+dr(d)
        nc=rc+dc(d)
   40   continue
        if (nr .lt. 1) goto 100
        if (nr .gt. 8) goto 100
        if (nc .lt. 1) goto 100
        if (nc .gt. 8) goto 100
        if (b(nr,nc) .eq. 1) goto 100
        if (b(nr,nc) .eq. -1) goto 100
        b(rr,rc)=0
        b(nr,nc)=2
        nmove=nmove+1
        call chk(b,8,8,res)
        if (res .eq. 0) goto 80
        legal=0
        do 50 k=1,4
          i=8+dr(k)
          j=8+dc(k)
          if (i .lt. 1) goto 50
          if (i .gt. 8) goto 50
          if (j .lt. 1) goto 50
          if (j .gt. 8) goto 50
          if (b(i,j) .eq. 1) goto 50
          sav=b(i,j)
          b(8,8)=0
          b(i,j)=-1
          call chk(b,i,j,res2)
          if (res2 .eq. 0) legal=1
          b(i,j)=sav
          b(8,8)=-1
          if (legal .eq. 1) goto 60
   50   continue
   60   continue
        if (legal .ne. 0) goto 80
        mate=mate+1
        mr=nr
        mc=nc
   80   b(nr,nc)=0
        b(rr,rc)=2
        nr=nr+dr(d)
        nc=nc+dc(d)
        goto 40
  100 continue
      return
      end
      subroutine chk(b,kr,kc,res)
      integer b(8,8),dr(4),dc(4)
      integer kr,kc,res,i,j,d,i1,i2,j1,j2
      dr(1)=-1
      dc(1)=0
      dr(2)=1
      dc(2)=0
      dr(3)=0
      dc(3)=-1
      dr(4)=0
      dc(4)=1
      res=0
      i1=kr-1
      i2=kr+1
      j1=kc-1
      j2=kc+1
      do 20 i=i1,i2
        do 20 j=j1,j2
          if (i .lt. 1) goto 20
          if (i .gt. 8) goto 20
          if (j .lt. 1) goto 20
          if (j .gt. 8) goto 20
          if (b(i,j) .eq. 1) res=1
   20 continue
      do 30 d=1,4
        i=kr
        j=kc
   31   i=i+dr(d)
        j=j+dc(d)
        if (i .lt. 1) goto 30
        if (i .gt. 8) goto 30
        if (j .lt. 1) goto 30
        if (j .gt. 8) goto 30
        if (b(i,j) .eq. 0) goto 31
        if (b(i,j) .eq. 2) res=1
        goto 30
   30 continue
      return
      end
*execute
*end file
