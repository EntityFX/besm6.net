*name scale kmeans
*fortran
      program kmeans
      real x(64,4),cent(4,4)
      real sums(4,4),dist,best,delta
      integer count(4),labels(64),i,j,k,it,c,cs
      do 10 i=1,64
        c=i-1-4*((i-1)/4)
        do 11 j=1,4
          k=i*7+j*3
          x(i,j)=10.*c+(k-16*(k/16))*0.0625
   11   continue
   10 continue
      do 12 k=1,4
        do 13 j=1,4
          cent(k,j)=x(k,j)
   13   continue
   12 continue
      do 50 it=1,10
        do 20 k=1,4
          count(k)=0
          do 21 j=1,4
            sums(k,j)=0.
   21     continue
   20   continue
        do 30 i=1,64
          c=1
          best=1.e10
          do 31 k=1,4
            dist=0.
            do 32 j=1,4
              delta=x(i,j)-cent(k,j)
              dist=dist+delta*delta
   32       continue
            if (dist .ge. best) goto 31
            best=dist
            c=k
   31     continue
          labels(i)=c
          count(c)=count(c)+1
          do 33 j=1,4
            sums(c,j)=sums(c,j)+x(i,j)
   33     continue
   30   continue
        do 40 k=1,4
          if (count(k) .eq. 0) goto 40
          do 41 j=1,4
            cent(k,j)=sums(k,j)/count(k)
   41     continue
   40   continue
   50 continue
      cs=0
      do 60 i=1,64
        cs=cs+labels(i)
   60 continue
      iz001=64
      iz002=4
      iz003=4
      print 100,iz001,iz002,iz003,cs,cent(1,1)
      print 110, cent(4,4)
      stop
  100 format('RESULT',4i12,f18.6)
  110 format('EXTRA',f18.6)
      end
*execute
*end file
