*name scale perceptron
*fortran
      program perc
      real x(4,2),w(2),b,z,err,cs
      integer y(4),i,j,ep,seed,pred,nok
      seed=12345
      do 10 i=1,4
        do 11 j=1,2
          seed=seed*75+74
          seed=seed-65537*(seed/65537)
          x(i,j)=-1.
          if (seed .ge. 32768) x(i,j)=1.
   11   continue
        y(i)=0
        if (x(i,1)+x(i,2) .gt. 1.) y(i)=1
   10 continue
      do 12 j=1,2
        w(j)=0.
   12 continue
      b=0.
      do 30 ep=1,20
        do 20 i=1,4
          z=b
          do 21 j=1,2
            z=z+w(j)*x(i,j)
   21     continue
          pred=0
          if (z .gt. 0.) pred=1
          err=(y(i)-pred)*0.125
          do 22 j=1,2
            w(j)=w(j)+err*x(i,j)
   22     continue
          b=b+err
   20   continue
   30 continue
      nok=0
      do 40 i=1,4
        z=b
        do 41 j=1,2
          z=z+w(j)*x(i,j)
   41   continue
        pred=0
        if (z .gt. 0.) pred=1
        if (pred .eq. y(i)) nok=nok+1
   40 continue
      cs=b
      do 50 j=1,2
        cs=cs+j*w(j)
   50 continue
      iz001=4
      iz002=2
      iz003=20
      print 100,iz001,iz002,iz003,nok,cs
      stop
  100 format('RESULT',4i12,f18.6)
      end
*execute
*end file
