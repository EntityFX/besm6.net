*name scale kmeans
*fortran
      program kmeans
      real x(512,16),cent(8,16)
      real sums(8,16),dist,best,delta
      integer count(8),labels(512),i,j,k,it,c,cs
      do 10 i=1,512
        c=i-1-8*((i-1)/8)
        do 11 j=1,16
          k=i*7+j*3
          x(i,j)=10.*c+(k-16*(k/16))*0.0625
   11   continue
   10 continue
      do 12 k=1,8
        do 13 j=1,16
          cent(k,j)=x(k,j)
   13   continue
   12 continue
      do 50 it=1,20
        do 20 k=1,8
          count(k)=0
          do 21 j=1,16
            sums(k,j)=0.
   21     continue
   20   continue
        do 30 i=1,512
          c=1
          best=1.e10
          do 31 k=1,8
            dist=0.
            do 32 j=1,16
              delta=x(i,j)-cent(k,j)
              dist=dist+delta*delta
   32       continue
            if (dist .ge. best) goto 31
            best=dist
            c=k
   31     continue
          labels(i)=c
          count(c)=count(c)+1
          do 33 j=1,16
            sums(c,j)=sums(c,j)+x(i,j)
   33     continue
   30   continue
        do 40 k=1,8
          if (count(k) .eq. 0) goto 40
          do 41 j=1,16
            cent(k,j)=sums(k,j)/count(k)
   41     continue
   40   continue
   50 continue
      cs=0
      do 60 i=1,512
        cs=cs+labels(i)
   60 continue
      iz001=512
      iz002=16
      iz003=8
      print 100,iz001,iz002,iz003,cs,cent(1,1)
      print 110, cent(8,16)
      stop
  100 format('RESULT',4i12,f18.6)
  110 format('EXTRA',f18.6)
      end
*execute
*end file
