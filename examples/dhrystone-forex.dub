*name dhrystone-forex
*forex
      PROGRAM DHRY
C     Dhrystone 2.1, native FOREX 4.13, BESM-6 48-bit words.
C     Procedures follow the existing Pascal port of Dhrystone 2.1.
C     Native CHARACTER strings, block IF, COMMON and procedure calls.
C     Record/pointer fields are parallel arrays and node indices 1/2.
C     CTIME brackets only the benchmark body, not compilation/controls.
C     --guest-clock: model time in original/max, host time in virtual.
      INTEGER NUMBER,RUN,I,J,I1LOC,I2LOC,I3LOC,ELOC,ICH,NBAD
      INTEGER A1(50),A2(50,50),FUNC1,IPREF
      CHARACTER*30 S1,S2
      CHARACTER*30 OUTSTR
      CHARACTER*6 OUTCHR
      CHARACTER CHIDX
      LOGICAL FUNC2
      REAL CT0,RT0,CT1,RT1,SECS,DMIPS
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      INTEGER RPTRC(2),RDISC(2),RENUM(2),RINTC(2)
      CHARACTER*30 RSTRC(2)
      COMMON /REC/ RPTRC,RDISC,RENUM,RINTC,RSTRC
      DATA NUMBER/5000/
      PGLB=1
      RPTRC(1)=2
      RDISC(1)=0
      RENUM(1)=2
      RINTC(1)=40
      RSTRC(1)='DHRYSTONE PROGRAM, SOME STRING'
      RPTRC(2)=RPTRC(1)
      RDISC(2)=RDISC(1)
      RENUM(2)=RENUM(1)
      RINTC(2)=RINTC(1)
      RSTRC(2)=RSTRC(1)
      S1='DHRYSTONE PROGRAM, 1''ST STRING'
      S2='DHRYSTONE PROGRAM, 2''ND STRING'
      IGLOB=0
      BLOB=.FALSE.
      C1GLB=' '
      C2GLB=' '
      I1LOC=1
      I2LOC=1
      I3LOC=1
      ELOC=0
      DO 20 I=1,50
      A1(I)=0
      DO 10 J=1,50
   10 A2(I,J)=0
   20 CONTINUE
      A2(8,7)=10
      PRINT 900,NUMBER
      CALL CTIME(CT0,RT0)
C     Guard the DO loop: zero-trip is not assumed on BESM-6.
      IF (NUMBER .LE. 0) GO TO 110
      DO 100 RUN=1,NUMBER
      CALL PROC5
      CALL PROC4
      I1LOC=2
      I2LOC=3
      S2='DHRYSTONE PROGRAM, 2''ND STRING'
      ELOC=1
      BLOB=.NOT.FUNC2(S1,S2)
   30 IF (I1LOC .LT. I2LOC) THEN
         I3LOC=5*I1LOC-I2LOC
         CALL PROC7(I1LOC,I2LOC,I3LOC)
         I1LOC=I1LOC+1
         GO TO 30
      ENDIF
      CALL PROC8(A1,A2,I1LOC,I3LOC)
      CALL PROC1(PGLB)
      DO 40 ICH=65,ICHAR(C2GLB)
      CHIDX=CHAR(ICH)
      IF (ELOC .EQ. FUNC1(CHIDX,'C')) THEN
         CALL PROC6(0,ELOC)
         S2='DHRYSTONE PROGRAM, 3''RD STRING'
         I2LOC=RUN
         IGLOB=RUN
      ENDIF
   40 CONTINUE
      I2LOC=I2LOC*I1LOC
      I1LOC=I2LOC/I3LOC
      I2LOC=7*(I2LOC-I3LOC)-I1LOC
      CALL PROC2(I1LOC)
  100 CONTINUE
  110 CALL CTIME(CT1,RT1)
      SECS=RT1-RT0
      NBAD=0
C     18 original scalar, array and record/pointer controls.
      IF (IGLOB .NE. 5) NBAD=NBAD+1
      IF (.NOT.BLOB) NBAD=NBAD+1
      IF (C1GLB .NE. 'A') NBAD=NBAD+1
      IF (C2GLB .NE. 'B') NBAD=NBAD+1
      IF (A1(8) .NE. 7) NBAD=NBAD+1
      IF (A2(8,7) .NE. NUMBER+10) NBAD=NBAD+1
      IF (RDISC(1) .NE. 0) NBAD=NBAD+1
      IF (RENUM(1) .NE. 2) NBAD=NBAD+1
      IF (RINTC(1) .NE. 17) NBAD=NBAD+1
      IF (RDISC(2) .NE. 0) NBAD=NBAD+1
      IF (RENUM(2) .NE. 1) NBAD=NBAD+1
      IF (RINTC(2) .NE. 18) NBAD=NBAD+1
      IF (I1LOC .NE. 5) NBAD=NBAD+1
      IF (I2LOC .NE. 13) NBAD=NBAD+1
      IF (I3LOC .NE. 7) NBAD=NBAD+1
      IF (ELOC .NE. 1) NBAD=NBAD+1
      IF (RPTRC(1) .NE. 2) NBAD=NBAD+1
      IF (RPTRC(2) .NE. 2) NBAD=NBAD+1
C     Four exact CHARACTER string controls, outside the timed interval.
      IF (RSTRC(1) .NE. 'DHRYSTONE PROGRAM, SOME STRING')
     + NBAD=NBAD+1
      IF (RSTRC(2) .NE. 'DHRYSTONE PROGRAM, SOME STRING')
     + NBAD=NBAD+1
      IF (S1 .NE. 'DHRYSTONE PROGRAM, 1''ST STRING') NBAD=NBAD+1
      IF (S2 .NE. 'DHRYSTONE PROGRAM, 2''ND STRING') NBAD=NBAD+1
      PRINT 940,IGLOB,BLOB
      OUTCHR=C1GLB
      PRINT 946,OUTCHR
      OUTCHR=C2GLB
      PRINT 947,OUTCHR
      IPREF=A1(8)
      PRINT 941,IPREF
      IPREF=A2(8,7)
      PRINT 942,IPREF
      PRINT 943,RDISC(1),RENUM(1),RINTC(1),RPTRC(1)
      PRINT 944,RDISC(2),RENUM(2),RINTC(2),RPTRC(2)
      PRINT 945,I1LOC,I2LOC,I3LOC,ELOC
C     FOREX expands CHARACTER*30 into five 6-byte words for formatted
C     output. 5A6 prints the full string without restarting the format.
C     Copy record string elements and packed COMMON character fields
C     to standalone output temporaries; all output is outside CTIME.
      OUTSTR=RSTRC(1)
      PRINT 950,OUTSTR
      OUTSTR=RSTRC(2)
      PRINT 951,OUTSTR
      PRINT 952,S1
      PRINT 953,S2
      PRINT 960,NBAD
      IF (NUMBER .LE. 0) THEN
         PRINT 1260
      ELSE IF (NBAD .NE. 0) THEN
         PRINT 1250
      ELSE
         PRINT 1200
         PRINT 1210
         IF (SECS .LT. 0.04) THEN
            PRINT 1240
         ELSE
            DMIPS=FLOAT(NUMBER)/(SECS*1757.)
            PRINT 1220,SECS
            PRINT 1230,DMIPS
         ENDIF
      ENDIF
      STOP
  900 FORMAT ('DHRYSTONE 2.1 (NATIVE FOREX FOR BESM-6)',/,
     + 'RUNNING ',I8,' PASSES')
  940 FORMAT ('IGLOB: ',I8,/,'BLOB: ',L6)
  946 FORMAT ('C1GLB: ',A1)
  947 FORMAT ('C2GLB: ',A1)
  941 FORMAT ('A1GLOB 8: ',I8)
  942 FORMAT ('A2GLOB 8/7: ',I8)
  943 FORMAT ('PGLB.DISCR: ',I8,/,'PGLB.ENUM: ',I8,/,
     + 'PGLB.INT: ',I8,/,'PGLB.PTR: ',I8)
  944 FORMAT ('NEXTP.DISCR: ',I8,/,'NEXTP.ENUM: ',I8,/,
     + 'NEXTP.INT: ',I8,/,'NEXTP.PTR: ',I8)
  945 FORMAT ('I1LOC: ',I8,/,'I2LOC: ',I8,/,'I3LOC: ',I8,/,
     + 'ELOC: ',I8)
  950 FORMAT ('PGLB.STR: ',5A6)
  951 FORMAT ('NEXTP.STR: ',5A6)
  952 FORMAT ('LOCAL STRING1: ',5A6)
  953 FORMAT ('LOCAL STRING2: ',5A6)
  960 FORMAT ('BAD CONTROL VALUES=',I6)
 1200 FORMAT ('ALL 18 CONTROL VALUES MATCH THE DHRYSTONE 2.1 SPEC')
 1210 FORMAT ('ALL 4 STRING VALUES MATCH: YES')
 1220 FORMAT ('GUEST CPU SECONDS: ',F12.4)
 1230 FORMAT ('GUEST DMIPS: ',F12.6)
 1240 FORMAT ('DMIPS UNAVAILABLE: ENABLE --GUEST-CLOCK OR RUN LONGER')
 1250 FORMAT ('DMIPS UNAVAILABLE: CONTROL VALUES DO NOT MATCH')
 1260 FORMAT ('DMIPS UNAVAILABLE: ZERO PASSES')
      END

      SUBROUTINE PROC1(P)
      INTEGER P,NREC
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      INTEGER RPTRC(2),RDISC(2),RENUM(2),RINTC(2)
      CHARACTER*30 RSTRC(2)
      COMMON /REC/ RPTRC,RDISC,RENUM,RINTC,RSTRC
      NREC=RPTRC(P)
      RPTRC(NREC)=RPTRC(PGLB)
      RDISC(NREC)=RDISC(PGLB)
      RENUM(NREC)=RENUM(PGLB)
      RINTC(NREC)=RINTC(PGLB)
      RSTRC(NREC)=RSTRC(PGLB)
      RINTC(P)=5
      RINTC(NREC)=RINTC(P)
      RPTRC(NREC)=RPTRC(P)
      CALL PROC3(RPTRC(NREC))
      IF (RDISC(NREC) .EQ. 0) THEN
         RINTC(NREC)=6
         CALL PROC6(RENUM(P),RENUM(NREC))
         RPTRC(NREC)=RPTRC(PGLB)
         CALL PROC7(RINTC(NREC),10,RINTC(NREC))
      ELSE
         RPTRC(P)=RPTRC(NREC)
         RDISC(P)=RDISC(NREC)
         RENUM(P)=RENUM(NREC)
         RINTC(P)=RINTC(NREC)
         RSTRC(P)=RSTRC(NREC)
      ENDIF
      RETURN
      END

      SUBROUTINE PROC2(INTREF)
      INTEGER INTREF,INTLOC,ENUMLO
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      INTLOC=INTREF+10
      ENUMLO=1
   10 IF (C1GLB .EQ. 'A') THEN
         INTLOC=INTLOC-1
         INTREF=INTLOC-IGLOB
         ENUMLO=0
      ENDIF
      IF (ENUMLO .NE. 0) GO TO 10
      RETURN
      END

      SUBROUTINE PROC3(PTRREF)
      INTEGER PTRREF
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      INTEGER RPTRC(2),RDISC(2),RENUM(2),RINTC(2)
      CHARACTER*30 RSTRC(2)
      COMMON /REC/ RPTRC,RDISC,RENUM,RINTC,RSTRC
      IF (PGLB .NE. 0) PTRREF=RPTRC(PGLB)
      CALL PROC7(10,IGLOB,RINTC(PGLB))
      RETURN
      END

      SUBROUTINE PROC4
      LOGICAL BOOLLO
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      BOOLLO=C1GLB .EQ. 'A'
      BLOB=BOOLLO .OR. BLOB
      C2GLB='B'
      RETURN
      END

      SUBROUTINE PROC5
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      C1GLB='A'
      BLOB=.FALSE.
      RETURN
      END

      SUBROUTINE PROC6(ENUMVA,ENUMRE)
      INTEGER ENUMVA,ENUMRE
      LOGICAL FUNC3
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      ENUMRE=ENUMVA
      IF (.NOT.FUNC3(ENUMVA)) ENUMRE=3
      IF (ENUMVA .EQ. 0) THEN
         ENUMRE=0
      ELSE IF (ENUMVA .EQ. 1) THEN
         IF (IGLOB .GT. 100) THEN
            ENUMRE=0
         ELSE
            ENUMRE=3
         ENDIF
      ELSE IF (ENUMVA .EQ. 2) THEN
         ENUMRE=1
      ELSE IF (ENUMVA .EQ. 4) THEN
         ENUMRE=2
      ENDIF
      RETURN
      END

      SUBROUTINE PROC7(INT1,INT2,INTREF)
      INTEGER INT1,INT2,INTREF,INTLOC
      INTLOC=INT1+2
      INTREF=INT2+INTLOC
      RETURN
      END

      SUBROUTINE PROC8(ARR1,ARR2,INT1,INT2)
      INTEGER ARR1(50),ARR2(50,50),INT1,INT2,INTLOC,IDX
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      INTLOC=INT1+5
      ARR1(INTLOC)=INT2
      ARR1(INTLOC+1)=ARR1(INTLOC)
      ARR1(INTLOC+30)=INTLOC
      DO 10 IDX=INTLOC,INTLOC+1
   10 ARR2(INTLOC,IDX)=INTLOC
      ARR2(INTLOC,INTLOC-1)=ARR2(INTLOC,INTLOC-1)+1
      ARR2(INTLOC+20,INTLOC)=ARR1(INTLOC)
      IGLOB=5
      RETURN
      END

      INTEGER FUNCTION FUNC1(CH1,CH2)
      CHARACTER CH1,CH2,CLOC1,CLOC2
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      CLOC1=CH1
      CLOC2=CLOC1
      IF (CLOC2 .NE. CH2) THEN
         FUNC1=0
      ELSE
         C1GLB=CLOC1
         FUNC1=1
      ENDIF
      RETURN
      END

      LOGICAL FUNCTION FUNC2(STR1,STR2)
      CHARACTER*30 STR1,STR2
      CHARACTER CHLOC
      INTEGER INTLOC,FUNC1
      INTEGER IGLOB,PGLB
      LOGICAL BLOB
      CHARACTER C1GLB,C2GLB
      COMMON /GLOB/ IGLOB,PGLB,BLOB,C1GLB,C2GLB
      INTLOC=2
   10 IF (INTLOC .LE. 2) THEN
         IF (FUNC1(STR1(INTLOC:INTLOC),
     +             STR2(INTLOC+1:INTLOC+1)) .EQ. 0) THEN
            CHLOC='A'
            INTLOC=INTLOC+1
         ENDIF
         GO TO 10
      ENDIF
      IF (CHLOC .GE. 'W' .AND. CHLOC .LT. 'Z') INTLOC=7
      IF (CHLOC .EQ. 'R') THEN
         FUNC2=.TRUE.
      ELSE IF (STR1 .GT. STR2) THEN
         INTLOC=INTLOC+7
         IGLOB=INTLOC
         FUNC2=.TRUE.
      ELSE
         FUNC2=.FALSE.
      ENDIF
      RETURN
      END

      LOGICAL FUNCTION FUNC3(ENUMVA)
      INTEGER ENUMVA,ENUMLO
      ENUMLO=ENUMVA
      FUNC3=ENUMLO .EQ. 2
      RETURN
      END
*execute
*end file
