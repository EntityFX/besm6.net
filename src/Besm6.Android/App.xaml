<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Besm6.Android.App">
    <Application.Resources>
        <ResourceDictionary>
            <!-- Light palette: warm gray paper with brown/red accents -->
            <Color x:Key="PageLight">#F3F1ED</Color>
            <Color x:Key="SurfaceLight">#FFFFFF</Color>
            <Color x:Key="SurfaceAltLight">#EAE6DF</Color>
            <Color x:Key="InkLight">#1D1B19</Color>
            <Color x:Key="MutedLight">#6D665F</Color>
            <Color x:Key="BorderLight">#D6D0C7</Color>
            <Color x:Key="AccentLight">#9B2C1F</Color>
            <Color x:Key="AccentSoftLight">#F2DFDA</Color>
            <Color x:Key="SuccessLight">#2E6A43</Color>
            <Color x:Key="DangerLight">#A83226</Color>

            <!-- Dark palette: charcoal with muted brown and red -->
            <Color x:Key="PageDark">#121212</Color>
            <Color x:Key="SurfaceDark">#1D1B19</Color>
            <Color x:Key="SurfaceAltDark">#292623</Color>
            <Color x:Key="InkDark">#F2EEE8</Color>
            <Color x:Key="MutedDark">#B5ADA4</Color>
            <Color x:Key="BorderDark">#3C3732</Color>
            <Color x:Key="AccentDark">#E06A58</Color>
            <Color x:Key="AccentSoftDark">#3A2622</Color>
            <Color x:Key="SuccessDark">#82C79A</Color>
            <Color x:Key="DangerDark">#FF8C7D</Color>

            <Style TargetType="ContentPage" ApplyToDerivedTypes="True">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource PageLight}, Dark={StaticResource PageDark}}" />
            </Style>

            <Style TargetType="Label">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="FontSize" Value="13" />
            </Style>

            <Style TargetType="Entry">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="PlaceholderColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="Editor">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BackgroundColor" Value="Transparent" />
            </Style>

            <Style TargetType="Picker">
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="TitleColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>

            <Style TargetType="Switch">
                <Setter Property="OnColor"
                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                <Setter Property="ThumbColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
            </Style>

            <Style x:Key="TitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="26" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="LineHeight" Value="1.05" />
            </Style>

            <Style x:Key="SubtitleLabel" TargetType="Label">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>

            <Style x:Key="SectionLabel" TargetType="Label">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="CharacterSpacing" Value="1.2" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
            </Style>

            <Style x:Key="Card" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="Stroke"
                        Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 18" />
                <Setter Property="Padding" Value="14" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#000000" Opacity="0.07" Radius="16" Offset="0,5" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="GroupCard" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
                <Setter Property="StrokeThickness" Value="0" />
                <Setter Property="StrokeShape" Value="RoundRectangle 14" />
                <Setter Property="Padding" Value="12" />
            </Style>

            <Style x:Key="PopupCard" TargetType="Border">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="Stroke"
                        Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <Setter Property="StrokeThickness" Value="1" />
                <Setter Property="StrokeShape" Value="RoundRectangle 22" />
                <Setter Property="Shadow">
                    <Setter.Value>
                        <Shadow Brush="#000000" Opacity="0.28" Radius="28" Offset="0,12" />
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource AccentLight}, Dark={StaticResource AccentDark}}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontAttributes" Value="Bold" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="16,8" />
                <Setter Property="MinimumHeightRequest" Value="48" />
            </Style>

            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceAltLight}, Dark={StaticResource SurfaceAltDark}}" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BorderColor"
                        Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontSize" Value="14" />
                <Setter Property="CornerRadius" Value="14" />
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="MinimumHeightRequest" Value="44" />
            </Style>

            <Style x:Key="GhostButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource MutedLight}, Dark={StaticResource MutedDark}}" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="8,4" />
                <Setter Property="MinimumHeightRequest" Value="32" />
            </Style>

            <Style x:Key="ToolButton" TargetType="Button">
                <Setter Property="BackgroundColor"
                        Value="{AppThemeBinding Light={StaticResource SurfaceLight}, Dark={StaticResource SurfaceDark}}" />
                <Setter Property="TextColor"
                        Value="{AppThemeBinding Light={StaticResource InkLight}, Dark={StaticResource InkDark}}" />
                <Setter Property="BorderColor"
                        Value="{AppThemeBinding Light={StaticResource BorderLight}, Dark={StaticResource BorderDark}}" />
                <Setter Property="BorderWidth" Value="1" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="Padding" Value="5,4" />
                <Setter Property="MinimumHeightRequest" Value="44" />
                <Setter Property="MinimumWidthRequest" Value="0" />
            </Style>

            <Style x:Key="BarButton" TargetType="Button" BasedOn="{StaticResource ToolButton}">
                <Setter Property="MinimumHeightRequest" Value="36" />
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Padding" Value="4,2" />
            </Style>

            <Style x:Key="MonoLabel" TargetType="Label">
                <Setter Property="FontFamily" Value="monospace" />
                <Setter Property="FontSize" Value="11" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
